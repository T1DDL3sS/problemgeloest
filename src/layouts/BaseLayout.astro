---
import Analytics from '../components/Analytics.astro';

const {
  title = 'ProblemGelöst',
  description = 'Konkrete Probleme. Klare Lösungen.'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f3d2e" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <style is:global>
      :root {
        --ink: #17231d;
        --ink-soft: #4f5f56;
        --brand: #0f3d2e;
        --brand-2: #175844;
        --accent: #dff5e8;
        --accent-strong: #bde9cf;
        --surface: #ffffff;
        --surface-soft: #f5f8f6;
        --border: #dfe7e2;
        --warning: #fff8df;
        --shadow: 0 14px 36px rgba(20, 53, 38, .08);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--surface-soft);
        font-synthesis: none;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; line-height: 1.6; }
      a { color: inherit; }
      button, input { font: inherit; }

      .site-header {
        background: rgba(255,255,255,.94);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(12px);
      }

      .header-inner,
      .page-shell,
      .footer-inner {
        width: min(1080px, calc(100% - 36px));
        margin-inline: auto;
      }

      .header-inner {
        min-height: 70px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 850;
        letter-spacing: -.03em;
        font-size: 1.12rem;
      }

      .brand-mark {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: var(--brand);
        color: white;
        display: grid;
        place-items: center;
        font-size: 1rem;
        box-shadow: 0 6px 16px rgba(15,61,46,.16);
      }

      .header-tagline {
        color: var(--ink-soft);
        font-size: .9rem;
      }

      main.page-shell { padding: 44px 0 80px; }

      h1, h2, h3, p { margin-top: 0; }
      h1 {
        font-size: clamp(2.35rem, 7vw, 4.8rem);
        line-height: .98;
        letter-spacing: -.055em;
        margin-bottom: 20px;
        max-width: 900px;
      }
      h2 {
        font-size: clamp(1.55rem, 3vw, 2rem);
        line-height: 1.15;
        letter-spacing: -.035em;
        margin-bottom: 18px;
      }
      h3 {
        font-size: 1.08rem;
        line-height: 1.3;
        letter-spacing: -.015em;
      }
      p, li { color: var(--ink-soft); }

      .eyebrow,
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--brand-2);
      }

      .breadcrumb {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: #718078;
        font-size: .88rem;
        margin-bottom: 26px;
      }
      .breadcrumb a { text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }

      .hero-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 26px;
        padding: clamp(26px, 5vw, 54px);
        box-shadow: var(--shadow);
        margin-bottom: 28px;
      }

      .hero-intro {
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        max-width: 760px;
        margin-bottom: 0;
      }

      .diagnosis-line {
        margin-top: 18px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: var(--ink);
        font-weight: 700;
      }
      .diagnosis-line .dot {
        flex: 0 0 10px;
        width: 10px;
        height: 10px;
        background: #39a56b;
        border-radius: 999px;
        margin-top: .48em;
        box-shadow: 0 0 0 5px #e6f6ed;
      }

      .quick-action {
        background: var(--brand);
        color: white;
        border-radius: 24px;
        padding: clamp(24px, 4vw, 38px);
        margin: 0 0 32px;
        box-shadow: 0 16px 38px rgba(15,61,46,.17);
      }
      .quick-action .eyebrow { color: #bfead0; }
      .quick-action h2 { color: white; margin: 9px 0 8px; }
      .quick-action > p { color: #d7e8df; max-width: 760px; }
      .quick-steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 12px;
        margin-top: 22px;
      }
      .quick-step {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 16px;
        padding: 16px;
        color: white;
      }
      .quick-step-number {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        background: white;
        color: var(--brand);
        border-radius: 9px;
        font-size: .8rem;
        font-weight: 900;
        margin-bottom: 10px;
      }
      .quick-step p { color: white; margin: 0; font-size: .94rem; }

      .content-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: clamp(24px, 4vw, 34px);
        margin: 0 0 22px;
      }

      .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
      }
      .section-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--accent);
        display: grid;
        place-items: center;
        font-weight: 900;
        color: var(--brand);
      }
      .section-heading h2 { margin: 0; }

      .diagnosis-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
      .mini-card {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 19px;
      }
      .mini-card h3 { margin-bottom: 10px; }
      .clean-list { margin: 0; padding: 0; list-style: none; }
      .clean-list li {
        position: relative;
        padding-left: 20px;
        margin: 9px 0;
      }
      .clean-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: .68em;
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: #6bb88a;
      }

      .solution-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 14px;
      }
      .solution-card {
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 21px;
        display: flex;
        flex-direction: column;
        min-height: 220px;
        background: white;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      }
      .solution-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(30,56,43,.08);
        border-color: #cbd9d0;
      }
      .solution-card.featured {
        border-color: #9fd8b8;
        background: #fbfffc;
      }
      .pill {
        display: inline-flex;
        align-self: flex-start;
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--accent);
        color: var(--brand);
        font-size: .72rem;
        font-weight: 850;
        margin-bottom: 14px;
      }
      .solution-card h3 { margin: 0 0 9px; font-size: 1.1rem; }
      .solution-card p { margin-bottom: 18px; font-size: .93rem; }
      .solution-action {
        margin-top: auto;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 42px;
        border-radius: 11px;
        background: var(--brand);
        color: white;
        font-weight: 800;
        font-size: .9rem;
        text-decoration: none;
        padding: 0 14px;
      }
      .solution-action.placeholder {
        background: #edf2ef;
        color: #627168;
        cursor: default;
      }
      .disclosure {
        color: #7c8982;
        font-size: .82rem;
        margin: -8px 0 18px;
      }

      .steps-list { margin: 0; padding: 0; list-style: none; }
      .steps-list li {
        display: grid;
        grid-template-columns: 42px 1fr;
        gap: 14px;
        align-items: start;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
      .steps-list li:last-child { border-bottom: 0; padding-bottom: 0; }
      .step-number {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--accent);
        color: var(--brand);
        display: grid;
        place-items: center;
        font-weight: 900;
      }
      .steps-list p { margin: 6px 0 0; }

      .prevention-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 12px;
      }
      .prevention-item {
        display: flex;
        gap: 10px;
        background: var(--surface-soft);
        border-radius: 14px;
        padding: 15px;
        color: var(--ink-soft);
      }
      .check {
        flex: 0 0 24px;
        width: 24px;
        height: 24px;
        border-radius: 999px;
        background: var(--accent-strong);
        color: var(--brand);
        display: grid;
        place-items: center;
        font-size: .8rem;
        font-weight: 900;
      }

      .faq-list { display: grid; gap: 10px; }
      details.faq-item {
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 0 17px;
        background: white;
      }
      details.faq-item summary {
        cursor: pointer;
        list-style: none;
        padding: 17px 28px 17px 0;
        font-weight: 800;
        color: var(--ink);
        position: relative;
      }
      details.faq-item summary::-webkit-details-marker { display: none; }
      details.faq-item summary::after {
        content: "+";
        position: absolute;
        right: 0;
        font-size: 1.35rem;
        color: var(--brand);
        top: 12px;
      }
      details.faq-item[open] summary::after { content: "–"; }
      details.faq-item p { padding: 0 0 17px; margin: 0; }

      .related-links { display: flex; flex-wrap: wrap; gap: 10px; }
      .related-link {
        border: 1px solid var(--border);
        background: var(--surface-soft);
        border-radius: 999px;
        padding: 9px 13px;
        text-decoration: none;
        font-size: .9rem;
        font-weight: 700;
        color: var(--brand);
      }
      .related-link:hover { background: var(--accent); }

      /* Startseite */
      .home-hero {
        text-align: center;
        padding: 42px 0 24px;
      }
      .home-hero h1 { margin-inline: auto; max-width: 800px; }
      .home-hero .lead {
        font-size: 1.14rem;
        max-width: 620px;
        margin: 0 auto 28px;
      }
      .search-box {
        max-width: 720px;
        margin: 0 auto;
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--shadow);
      }
      .search-icon { padding-left: 10px; color: #718078; }
      .search-box input {
        border: 0;
        outline: 0;
        width: 100%;
        padding: 13px 4px;
        color: var(--ink);
        background: transparent;
      }
      .home-section { margin-top: 38px; }
      .home-section-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 16px;
      }
      .home-section-header h2 { margin-bottom: 0; }
      .problem-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 14px;
      }
      .problem-card {
        display: block;
        text-decoration: none;
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 21px;
        transition: transform .18s ease, box-shadow .18s ease;
      }
      .problem-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(30,56,43,.08);
      }
      .problem-card .badge { margin-bottom: 9px; }
      .problem-card h3 { margin: 0 0 7px; font-size: 1.1rem; }
      .problem-card p { margin: 0; font-size: .9rem; }
      .problem-card .arrow { color: var(--brand); font-weight: 900; margin-top: 14px; }

      .site-footer {
        border-top: 1px solid var(--border);
        background: white;
      }
      .footer-inner {
        padding: 28px 0;
        display: flex;
        justify-content: space-between;
        gap: 18px;
        color: #718078;
        font-size: .84rem;
      }



      /* Interaktive Diagnose */
      .diagnosis-app {
        max-width: 920px;
        margin: 0 auto;
        padding: 34px 0 18px;
      }
      .diagnosis-topline {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        color: var(--brand-2);
        font-size: .78rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 18px;
      }
      .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: #36a76a;
        box-shadow: 0 0 0 5px #e4f7ec;
      }
      .diagnosis-heading {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 28px;
      }
      .diagnosis-heading h1 {
        font-size: clamp(2.65rem, 7vw, 5.4rem);
        max-width: none;
        margin-bottom: 18px;
      }
      .diagnosis-heading p {
        max-width: 650px;
        margin: 0 auto;
        font-size: 1.08rem;
      }
      .diagnosis-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 28px;
        box-shadow: 0 20px 55px rgba(25, 60, 42, .09);
        overflow: hidden;
        padding: clamp(22px, 5vw, 46px);
      }
      .progress-row {
        display: grid;
        grid-template-columns: auto 1fr auto 1fr auto;
        align-items: center;
        max-width: 520px;
        margin: 0 auto 38px;
      }
      .progress-line {
        height: 2px;
        background: #e5ece8;
      }
      .progress-step {
        display: grid;
        justify-items: center;
        gap: 7px;
        color: #849088;
        min-width: 72px;
      }
      .progress-step span {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: #eef2ef;
        color: #78847c;
        font-weight: 900;
        border: 1px solid #e2e8e4;
      }
      .progress-step em {
        font-style: normal;
        font-size: .74rem;
        font-weight: 800;
      }
      .progress-step.is-active span {
        background: var(--brand);
        color: white;
        border-color: var(--brand);
        box-shadow: 0 6px 15px rgba(15, 61, 46, .18);
      }
      .progress-step.is-active em { color: var(--brand); }
      .progress-step.is-done span {
        background: var(--accent);
        color: var(--brand);
        border-color: #ccebd8;
      }
      .answer-summary {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin: -10px 0 26px;
      }
      .answer-summary span {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 7px 11px;
        color: #59685f;
        font-size: .82rem;
        font-weight: 750;
      }
      .question-panel {
        max-width: 760px;
        margin: 0 auto;
      }
      .question-count {
        color: var(--brand-2);
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: .74rem;
        margin-bottom: 8px;
      }
      .question-panel h2 {
        font-size: clamp(1.55rem, 4vw, 2.35rem);
        margin-bottom: 8px;
      }
      .question-help {
        margin-bottom: 22px;
      }
      .diagnosis-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      .diagnosis-option {
        appearance: none;
        width: 100%;
        border: 1px solid var(--border);
        background: white;
        border-radius: 17px;
        padding: 16px;
        min-height: 86px;
        display: grid;
        grid-template-columns: 46px 1fr 24px;
        align-items: center;
        gap: 12px;
        text-align: left;
        cursor: pointer;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease, background .16s ease;
        color: var(--ink);
      }
      .diagnosis-option:hover {
        transform: translateY(-2px);
        border-color: #a9d2ba;
        box-shadow: 0 10px 25px rgba(27, 63, 44, .07);
        background: #fcfffd;
      }
      .diagnosis-option:focus-visible {
        outline: 3px solid #bde9cf;
        outline-offset: 2px;
      }
      .option-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: var(--accent);
        display: grid;
        place-items: center;
        font-size: 1.25rem;
        color: var(--brand);
        font-weight: 900;
      }
      .option-copy {
        display: grid;
        gap: 2px;
      }
      .option-copy strong {
        font-size: .98rem;
        color: var(--ink);
      }
      .option-copy small {
        color: #748078;
        font-size: .79rem;
        line-height: 1.35;
      }
      .option-arrow {
        color: #93a097;
        font-weight: 900;
      }
      .back-button,
      .secondary-button {
        border: 0;
        background: transparent;
        color: var(--brand);
        font-weight: 800;
        cursor: pointer;
        margin-top: 18px;
        padding: 8px 0;
      }
      .diagnosis-result {
        max-width: 760px;
        margin: 0 auto;
      }
      .result-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--brand-2);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        margin-bottom: 10px;
      }
      .result-kicker span {
        width: 27px;
        height: 27px;
        border-radius: 999px;
        background: var(--accent);
        display: grid;
        place-items: center;
      }
      .diagnosis-result h2 {
        font-size: clamp(2rem, 5vw, 3.4rem);
        margin-bottom: 14px;
      }
      .result-reason {
        font-size: 1.02rem;
        margin-bottom: 20px;
      }
      .result-reason strong { color: var(--ink); }
      .result-action-box {
        background: var(--brand);
        color: white;
        border-radius: 18px;
        padding: 20px;
        display: grid;
        gap: 5px;
        margin: 20px 0 14px;
      }
      .result-action-box span {
        color: #bfe5cd;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: .72rem;
        font-weight: 850;
      }
      .result-action-box strong {
        font-size: 1.02rem;
        line-height: 1.45;
      }
      .result-steps {
        display: grid;
        gap: 8px;
        margin: 16px 0 22px;
      }
      .result-steps > div {
        display: grid;
        grid-template-columns: 34px 1fr;
        gap: 10px;
        align-items: center;
        background: var(--surface-soft);
        border-radius: 12px;
        padding: 11px 13px;
      }
      .result-steps b {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--accent);
        color: var(--brand);
      }
      .result-steps span { color: #526158; font-size: .9rem; }
      .result-buttons {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }
      .primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 20px;
        border-radius: 13px;
        background: var(--brand);
        color: white;
        text-decoration: none;
        font-weight: 850;
        box-shadow: 0 10px 22px rgba(15,61,46,.13);
      }
      .result-disclaimer {
        font-size: .78rem;
        color: #87928b;
        margin: 16px 0 0;
      }
      .diagnosis-note {
        text-align: center;
        font-size: .78rem;
        color: #89938d;
        max-width: 680px;
        margin: 14px auto 0;
      }

      .direct-solutions {
        max-width: 980px;
        margin: 58px auto 0;
      }
      .section-title-row {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 18px;
      }
      .section-title-row h2 { margin: 6px 0 0; }
      .muted-label {
        color: #839087;
        font-size: .82rem;
      }
      .direct-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }
      .direct-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 19px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        min-height: 220px;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      }
      .direct-card:hover {
        transform: translateY(-2px);
        border-color: #c6d8cd;
        box-shadow: 0 12px 28px rgba(29, 61, 44, .07);
      }
      .direct-tag {
        color: var(--brand-2);
        font-size: .72rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: 10px;
      }
      .direct-card h3 { font-size: 1.05rem; margin-bottom: 8px; }
      .direct-card p { font-size: .87rem; line-height: 1.5; margin-bottom: 16px; }
      .direct-card > strong {
        color: var(--brand);
        margin-top: auto;
        font-size: .87rem;
      }
      .direct-card > strong span { margin-left: 3px; }

      .system-explainer {
        max-width: 980px;
        margin: 70px auto 10px;
        background: var(--brand);
        border-radius: 25px;
        padding: clamp(26px, 5vw, 46px);
        color: white;
      }
      .system-explainer .eyebrow { color: #bde9cf; }
      .system-explainer h2 { color: white; margin: 8px 0 24px; }
      .system-steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 12px;
      }
      .system-steps > div {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.11);
        border-radius: 16px;
        padding: 18px;
        display: grid;
        gap: 8px;
      }
      .system-steps span {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        background: white;
        color: var(--brand);
        border-radius: 10px;
        font-size: .82rem;
        font-weight: 900;
      }
      .system-steps strong { color: white; }
      .system-steps p { color: #d3e6db; margin: 0; font-size: .88rem; }

      .diagnosis-backlink {
        display: inline-flex;
        align-items: center;
        color: var(--brand);
        font-weight: 800;
        font-size: .86rem;
        text-decoration: none;
        margin: -12px 0 18px;
      }
      .diagnosis-backlink:hover { text-decoration: underline; }


      /* V3: Monetarisierung direkt im Diagnose-Treffer */
      .result-commerce {
        margin: 30px 0 26px;
        padding-top: 26px;
        border-top: 1px solid var(--border);
      }
      .commerce-heading {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: end;
        margin-bottom: 16px;
      }
      .commerce-kicker {
        display: block;
        color: var(--brand-2);
        font-size: .72rem;
        font-weight: 900;
        letter-spacing: .09em;
        text-transform: uppercase;
        margin-bottom: 5px;
      }
      .commerce-heading h3 {
        margin: 0;
        font-size: clamp(1.45rem, 3.5vw, 2rem);
      }
      .commerce-note {
        color: #7f8d85;
        font-size: .8rem;
        white-space: nowrap;
      }
      .result-product-card {
        position: relative;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .result-product-card.is-recommended {
        background: linear-gradient(135deg, #103f31 0%, #0d513d 100%);
        border-color: #0d513d;
        padding: 26px;
        box-shadow: 0 18px 38px rgba(15,61,46,.17);
        margin-bottom: 12px;
        overflow: hidden;
      }
      .recommended-ribbon {
        display: inline-flex;
        align-self: flex-start;
        background: #dff5e8;
        color: #0f4a38;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: .72rem;
        line-height: 1;
        font-weight: 900;
        letter-spacing: .02em;
        margin-bottom: 15px;
      }
      .product-card-label {
        color: var(--brand-2);
        font-size: .7rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 7px;
      }
      .result-product-card h4 {
        font-size: 1.2rem;
        margin: 0 0 8px;
      }
      .result-product-card p {
        font-size: .9rem;
        line-height: 1.55;
        margin: 0 0 18px;
        flex: 1;
      }
      .result-product-card.is-recommended .product-card-label { color: #bfe5cd; }
      .result-product-card.is-recommended h4 { color: #fff; font-size: clamp(1.35rem, 3vw, 1.7rem); }
      .result-product-card.is-recommended p { color: #d8ebe1; max-width: 680px; }
      .product-cta,
      .free-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        border: 0;
        border-radius: 12px;
        padding: 0 16px;
        text-decoration: none;
        font: inherit;
        font-size: .88rem;
        font-weight: 900;
        cursor: pointer;
        transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
      }
      .product-cta {
        background: var(--brand);
        color: #fff;
      }
      .product-cta:hover,
      .free-cta:hover { transform: translateY(-1px); }
      .product-cta.is-featured {
        align-self: flex-start;
        min-width: 220px;
        background: #fff;
        color: var(--brand);
        box-shadow: 0 8px 22px rgba(0,0,0,.14);
      }
      .free-cta {
        background: var(--surface-soft);
        color: var(--brand);
      }
      .result-alternatives {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      .result-product-card.is-free {
        background: #f8fbf9;
        border-style: dashed;
      }
      .result-quick-guide {
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }
      .quick-guide-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 12px;
      }
      .quick-guide-heading > span {
        font-weight: 900;
        font-size: 1rem;
      }
      .quick-guide-heading a,
      .detail-link {
        color: var(--brand);
        font-size: .83rem;
        font-weight: 850;
        text-decoration: none;
      }
      .quick-guide-heading a:hover,
      .detail-link:hover { text-decoration: underline; }
      .result-footer-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 18px;
      }
      .result-footer-actions .secondary-button { margin-top: 0; }
      .affiliate-toast {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%);
        width: max-content;
        max-width: calc(100vw - 28px);
        z-index: 50;
        border-radius: 12px;
        background: #15231d;
        color: #fff;
        padding: 12px 16px;
        box-shadow: 0 16px 35px rgba(0,0,0,.18);
        font-size: .85rem;
        font-weight: 750;
      }
      .affiliate-toast[hidden] { display: none; }




      /* V4: finaler Mobile-/Conversion-Pass. Bewusst schmal statt Desktop-Breitformat. */
      .diagnosis-app {
        max-width: 820px;
      }
      .diagnosis-app.is-result {
        padding-top: 10px;
      }
      .diagnosis-app.is-result .diagnosis-topline,
      .diagnosis-app.is-result .diagnosis-heading {
        display: none;
      }
      .diagnosis-app.is-result .progress-row {
        margin-bottom: 20px;
      }
      .diagnosis-app.is-result .answer-summary {
        margin-bottom: 18px;
      }

      .result-action-box {
        margin-bottom: 8px;
      }
      .result-commerce {
        margin-top: 22px;
        padding-top: 22px;
      }
      .commerce-heading {
        margin-bottom: 14px;
      }
      .commerce-heading h3 {
        font-size: clamp(1.35rem, 3.5vw, 1.8rem);
      }

      .result-product-card.is-recommended {
        padding: 22px;
        margin-bottom: 12px;
      }
      .recommended-ribbon {
        margin-bottom: 14px;
        background: #e6f7ed;
      }
      .recommended-product-main {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 18px;
        align-items: center;
      }
      .product-visual {
        width: 112px;
        aspect-ratio: 1;
        border-radius: 16px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        display: grid;
        place-items: center;
        align-content: center;
        gap: 5px;
        color: #d9eee3;
      }
      .product-visual-icon {
        font-size: 2rem;
        line-height: 1;
      }
      .product-visual small {
        color: #c7dfd2;
        font-size: .68rem;
        font-weight: 800;
      }
      .recommended-product-copy h4 {
        margin-bottom: 7px;
      }
      .recommended-product-copy p {
        margin: 0;
      }
      .product-benefits {
        list-style: none;
        padding: 0;
        margin: 18px 0;
        display: grid;
        gap: 8px;
      }
      .product-benefits li {
        position: relative;
        padding-left: 24px;
        color: #e2f0e8;
        font-size: .88rem;
        line-height: 1.4;
      }
      .product-benefits li::before {
        content: "✓";
        position: absolute;
        left: 0;
        top: 0;
        width: 17px;
        height: 17px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: #dff5e8;
        color: #0f4a38;
        font-size: .67rem;
        font-weight: 950;
      }
      .product-cta.is-featured {
        width: 100%;
        min-width: 0;
        min-height: 56px;
        font-size: .95rem;
      }

      .solution-path-badge {
        display: inline-flex;
        align-self: flex-start;
        padding: 6px 9px;
        border-radius: 999px;
        background: var(--accent);
        color: var(--brand);
        font-size: .69rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 14px;
      }
      .solution-path-badge.is-free-badge {
        background: #eef2ef;
        color: #526158;
      }
      .alternative-main {
        display: grid;
        grid-template-columns: 50px minmax(0,1fr);
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
      }
      .mini-product-visual {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        background: var(--accent);
        color: var(--brand);
        font-weight: 900;
        font-size: 1.2rem;
      }
      .mini-product-visual.is-free-visual {
        background: #eef2ef;
        color: #526158;
        font-size: .82rem;
      }
      .alternative-main .product-card-label {
        margin-bottom: 3px;
      }
      .alternative-main h4 {
        margin: 0;
      }
      .result-product-card.is-simple,
      .result-product-card.is-free {
        min-height: 230px;
      }
      .result-product-card.is-simple .product-cta,
      .result-product-card.is-free .free-cta {
        width: 100%;
        margin-top: auto;
      }

      .direct-solutions {
        transition: opacity .18s ease, filter .18s ease;
      }
      .direct-solutions.is-deemphasized {
        opacity: .5;
        filter: saturate(.65);
      }
      .direct-solutions.is-deemphasized:hover {
        opacity: .8;
        filter: none;
      }

      @media (max-width: 760px) {
        .diagnosis-app { max-width: 100%; }
        .diagnosis-app.is-result .diagnosis-card { padding-top: 18px; }
        .recommended-product-main { grid-template-columns: 92px minmax(0, 1fr); gap: 14px; }
        .product-visual { width: 92px; border-radius: 14px; }
        .product-benefits { margin-top: 16px; }
        .result-alternatives { grid-template-columns: 1fr; }
        .header-tagline { display: none; }
        main.page-shell { padding-top: 28px; }
        .hero-card { border-radius: 20px; }
        .quick-steps,
        .solution-grid,
        .prevention-grid,
        .diagnosis-grid,
        .problem-grid,
        .direct-grid,
        .system-steps { grid-template-columns: 1fr; }
        .quick-step { display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: start; }
        .quick-step-number { margin: 0; }
        .home-section-header { align-items: start; flex-direction: column; }
        .diagnosis-options { grid-template-columns: 1fr; }
        .section-title-row { align-items: start; flex-direction: column; }
        .commerce-heading { align-items: start; flex-direction: column; gap: 6px; }
        .commerce-note { white-space: normal; }
        .result-alternatives { grid-template-columns: 1fr; }
        .quick-guide-heading { align-items: start; flex-direction: column; }
        .diagnosis-app { padding-top: 18px; }
        .footer-inner { flex-direction: column; }
      }

      @media (max-width: 460px) {
        .diagnosis-app.is-result { padding-top: 2px; }
        .diagnosis-app.is-result .progress-row { margin-bottom: 14px; }
        .diagnosis-app.is-result .answer-summary { margin: -2px 0 14px; }
        .diagnosis-result h2 { font-size: clamp(1.75rem, 9vw, 2.35rem); }
        .result-reason { margin-bottom: 14px; }
        .result-action-box { padding: 17px; margin-top: 14px; }
        .result-commerce { margin-top: 18px; padding-top: 18px; }
        .result-product-card.is-recommended { padding: 18px; }
        .recommended-product-main { grid-template-columns: 78px minmax(0, 1fr); gap: 12px; }
        .product-visual { width: 78px; border-radius: 12px; }
        .product-visual-icon { font-size: 1.55rem; }
        .product-visual small { font-size: .59rem; }
        .result-product-card.is-recommended h4 { font-size: 1.22rem; }
        .product-benefits li { font-size: .84rem; }
        .product-cta.is-featured { min-height: 54px; }
        .direct-solutions.is-deemphasized { opacity: .4; }
        .header-inner, .page-shell, .footer-inner { width: min(100% - 24px, 1080px); }
        .header-inner { min-height: 62px; }
        .brand-mark { width: 29px; height: 29px; border-radius: 9px; }
        main.page-shell { padding-bottom: 56px; }
        .hero-card, .quick-action, .content-section { padding: 20px; border-radius: 18px; }
        h1 { font-size: clamp(2.15rem, 13vw, 3.25rem); }
        .diagnosis-card { padding: 18px; border-radius: 20px; }
        .progress-step { min-width: 52px; }
        .progress-step em { font-size: .66rem; }
        .diagnosis-option { min-height: 78px; padding: 13px; grid-template-columns: 42px 1fr 18px; }
        .option-icon { width: 42px; height: 42px; }
        .result-buttons { align-items: stretch; flex-direction: column; gap: 4px; }
        .primary-button { width: 100%; }
        .secondary-button { width: 100%; }
        .result-product-card.is-recommended { padding: 20px; }
        .product-cta.is-featured, .product-cta, .free-cta { width: 100%; }
        .result-footer-actions { align-items: stretch; flex-direction: column; }
      }
    </style>
  </head>
