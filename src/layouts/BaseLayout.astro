    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="ProblemGelöst Startseite">
          <span class="brand-mark" aria-hidden="true">✓</span>
          <span>ProblemGelöst</span>
        </a>
        <span class="header-tagline">Problem rein. Lösung raus.</span>
      </div>
    </header>
    <main class="page-shell"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© ProblemGelöst</span>
        <span>Konkrete Alltagsprobleme. Klare Lösungen.</span>
      </div>
    </footer>
    <Analytics />
